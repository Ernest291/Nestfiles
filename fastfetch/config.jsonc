{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
	"source": "~/Pictures/anime/mikubg.png",
    "type": "kitty",
    "width": 24,
    "height": 12,
	"padding": {
		"top": 0,
		"right": 2,
		"bottom": 0,
		"left": 2
	}
    },
    "display": {
        "separator": " >  "
    },
    "modules": [
	"break",
        {
            "type": "os",
            "key": "OS  ",
            "keyColor": "31",  // = color1
        },
        {
            "type": "kernel",
            "key": "KER ",
            "keyColor": "32",
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": "PKG ",
            "keyColor": "33",  
        },
        {
            "type": "shell",
            "key": "SH  ",
            "keyColor": "34", 
        },
        {
            "type": "terminal",
            "key": "TER ",
            "keyColor": "35", 
        },
        {
            "type": "wm",
            "key": "WM  ",
            "keyColor": "36", 
        },
        {
            "type": "gpu",
            "key": "GPU ",
            "keyColor": "36"
        },
        {
            "type": "cpu",
            "key": "CPU ",
            "keyColor": "35"
        },

        "break"

    ]
        
}
